package ru.oop.task7;

public class SwitchFallthroughDemo {
    public static void main(String[] args) {
        int x = 2;
        System.out.println("x = " + x);
        
        int result = 0;
        switch (x) {
            case 1:
                result = 1;
            case 2:
                result = 2;
            case 3:
                result = 3;
                break;
            default:
                result = 0;
        }
        System.out.println("Результат при отсутствии break: " + result);
        System.out.println("Выполнение 'провалилось' из case 2 в case 3");
        
        int month = 3;
        String season;
        switch (month) {
            case 12: case 1: case 2:
                season = "Зима"; break;
            case 3: case 4: case 5:
                season = "Весна"; break;
            case 6: case 7: case 8:
                season = "Лето"; break;
            case 9: case 10: case 11:
                season = "Осень"; break;
            default:
                season = "Неизвестно";
        }
        System.out.println("Месяц " + month + " -> сезон: " + season);
    }
}
