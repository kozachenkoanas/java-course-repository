package ru.oop.task21;

public class PrintfSpecifiersDemo {
    public static void main(String[] args) {
        String name = "Анастасия";
        int age = 19;
        double height = 1.68;
        char grade = 'A';
        int hexValue = 255;
        boolean isStudent = true;
        
        System.out.println("Спецификаторы форматирования printf:\n");
        
        System.out.printf("%d - целое число (int, byte, short, long)%n", age);
        System.out.printf("%f - число с плавающей точкой (float, double)%n", height);
        System.out.printf("%s - строка (String)%n", name);
        System.out.printf("%c - символ (char)%n", grade);
        System.out.printf("%x - шестнадцатеричное число%n", hexValue);
        System.out.printf("%X - шестнадцатеричное число (заглавные буквы)%n", hexValue);
        System.out.printf("%o - восьмеричное число%n", hexValue);
        System.out.printf("%b - булевский тип (boolean)%n", isStudent);
        System.out.printf("%e - экспоненциальная форма%n", 12345.6789);
        System.out.printf("%% - символ процента%n");
        
        System.out.println("\nФлаги форматирования:");
        System.out.printf("%10s - выравнивание вправо (ширина 10)%n", name);
        System.out.printf("%-10s - выравнивание влево (ширина 10)%n", name);
        System.out.printf("%.2f - два знака после запятой%n", height);
        System.out.printf("%08d - дополнение нулями до 8 цифр%n", age);
        System.out.printf("%,d - разделитель тысяч%n", 1000000);
        
        System.out.println("\nПримеры комбинаций:");
        System.out.printf("Имя: %s, Возраст: %d, Рост: %.2f м%n", name, age, height);
        System.out.printf("%-10s | %5d | %8.2f%n", "Продукт", 100, 99.99);
        System.out.printf("%-10s | %5d | %8.2f%n", "Услуга", 3, 1500.5);
    }
}
