package ru.oop.task22;

import java.io.*;

public class ReaderWriterVsStreamDemo {
    public static void main(String[] args) {
        System.out.println("Зачем нужны Reader и Writer?\n");
        
        System.out.println("InputStream/OutputStream (байтовые потоки):");
        System.out.println("- Работают с байтами (8 бит)");
        System.out.println("- Подходят для бинарных данных (изображения, аудио, видео)");
        System.out.println("- Не учитывают кодировку символов");
        
        System.out.println("\nReader/Writer (символьные потоки):");
        System.out.println("- Работают с символами Unicode (16 бит)");
        System.out.println("- Подходят для текстовых данных");
        System.out.println("- Учитывают кодировку (UTF-8, UTF-16, Cp1251 и т.д.)");
        
        System.out.println("\nПример проблемы с байтовыми потоками для текста:");
        String text = "Привет мир!";
        byte[] bytes = text.getBytes();
        System.out.println("Строка: " + text);
        System.out.print("Байты: ");
        for (byte b : bytes) {
            System.out.print(b + " ");
        }
        
        System.out.println("\n\nПример с Reader/Writer:");
        try (StringReader reader = new StringReader(text);
             StringWriter writer = new StringWriter()) {
            int ch;
            while ((ch = reader.read()) != -1) {
                writer.write(ch);
            }
            System.out.println("Прочитано через Reader: " + writer.toString());
        } catch (IOException e) {
            System.out.println("Ошибка: " + e.getMessage());
        }
        
        System.out.println("\nВывод:");
        System.out.println("- Для текста всегда используйте Reader/Writer");
        System.out.println("- Для бинарных данных используйте InputStream/OutputStream");
        System.out.println("- InputStreamReader и OutputStreamWriter соединяют обе иерархии");
    }
}
