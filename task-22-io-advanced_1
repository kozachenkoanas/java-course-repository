package ru.oop.task22;

import java.io.FileOutputStream;
import java.io.IOException;
import java.io.OutputStream;

public class OutputStreamWriteDemo {
    public static void main(String[] args) {
        System.out.println("OutputStream метод write(int)\n");
        
        byte[] data = {65, 66, 67, 10, 68, 69, 70};
        
        System.out.println("Метод write(int b) записывает один байт (младшие 8 бит)");
        System.out.println("65 -> 'A', 66 -> 'B', 67 -> 'C', 10 -> '\\n', 68 -> 'D', 69 -> 'E', 70 -> 'F'");
        
        try (OutputStream out = new FileOutputStream("output_write_demo.txt")) {
            for (byte b : data) {
                out.write(b);
                System.out.println("Записан байт: " + b + " (" + (char) b + ")");
            }
            out.flush();
            System.out.println("\nДанные записаны в файл output_write_demo.txt");
        } catch (IOException e) {
            System.out.println("Ошибка: " + e.getMessage());
        }
        
        System.out.println("\nДругие методы OutputStream:");
        System.out.println("write(byte[] b) - запись массива байт");
        System.out.println("write(byte[] b, int off, int len) - запись части массива");
        System.out.println("flush() - принудительная запись буфера");
        System.out.println("close() - закрытие потока");
    }
}
