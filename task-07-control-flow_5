package ru.oop.task7;

public class BreakContinueDemo {
    public static void main(String[] args) {
        System.out.println("break в for:");
        for (int i = 1; i <= 10; i++) {
            if (i == 5) {
                System.out.println("break на i = " + i);
                break;
            }
            System.out.println("i = " + i);
        }
        
        System.out.println("\ncontinue в for (пропуск чётных):");
        for (int i = 1; i <= 10; i++) {
            if (i % 2 == 0) {
                System.out.println("continue на i = " + i);
                continue;
            }
            System.out.println("нечётное i = " + i);
        }
        
        System.out.println("\nbreak с меткой (выход из вложенных циклов):");
        outerLoop:
        for (int i = 1; i <= 3; i++) {
            for (int j = 1; j <= 3; j++) {
                if (i == 2 && j == 2) {
                    System.out.println("break outerLoop при i=" + i + ", j=" + j);
                    break outerLoop;
                }
                System.out.println("i=" + i + ", j=" + j);
            }
        }
    }
}
